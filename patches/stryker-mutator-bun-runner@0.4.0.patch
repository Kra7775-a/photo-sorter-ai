+            const failedLine = lines.find((l) => /^\s*(\d+)\s+fail\s*$/.test(l));
+            const passed = Number(passedLine?.match(/(\d+)/)?.[1] ?? 0);
+            const failed = Number(failedLine?.match(/(\d+)/)?.[1] ?? 0);
+            if (passedLine && failedLine) {
+                const status = failed > 0 ? 'failed' : 'passed';
+                const test = { name: 'bun test suite', status, duration };
+                parseResult.tests.push(test);
+                parseResult.passed = passed;
+                parseResult.failed = failed;
+                parseResult.total = passed + failed;
+                parseResult.failedTests = failed > 0 ? [test] : [];
+            }
+        }
         this.log.debug(`Parsed ${parseResult.total} tests: ${parseResult.passed} passed, ${parseResult.failed} failed`);
         return {
             ...parseResult,
