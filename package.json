{
  "name": "photo-sorter-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "dev:all": "bun scripts/dev-all.ts",
    "dev:server": "bun --watch server/main.ts",
    "start": "bun server/main.ts",
    "keygen": "bun server/keygen.ts",
    "rewrap": "bun server/rewrap.ts",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.app.json",
    "typecheck": "bun check --no-script -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test --conditions=browser --isolate --pass-with-no-tests",
    "test:watch": "bun test --conditions=browser --isolate --watch --pass-with-no-tests",
    "test:coverage": "bun test --conditions=browser --isolate --coverage --pass-with-no-tests",
    "test:mutation": "bun scripts/mutation.ts full",
    "test:mutation:diff": "bun scripts/mutation.ts diff",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "arch:check": "depcruise src server --validate",
    "arch:graph": "depcruise src server --output-type mermaid",
    "dup": "jscpd --config .jscpd.json src server scripts tests docs",
    "unused": "knip --config knip.json",
    "spell": "cspell --config cspell.json --no-progress \"**/*\"",
    "secrets": "secretlint \"**/*\" --secretlintignore .gitignore",
    "docs:lint": "markdownlint-cli2 \"**/*.md\"",
    "quality": "bun run dup && bun run unused && bun run spell && bun run secrets && bun run docs:lint",
    "validate": "bun run format:check && bun run lint && bun run arch:check && bun run typecheck && bun run check && bun run test && bun run build",
    "hooks:install": "lefthook install",
    "sast": "bun scripts/semgrep.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@zip.js/zip.js": "2.25.0",
    "better-auth": "1.7.27",
    "bits-ui": "2.22.0",
    "client-zip": "2.5.1",
    "elysia": "2.0.0-rc.5",
    "idb": "8.0.4",
    "phosphor-svelte": "3.1.1",
    "tailwind-variants": "4.0.2"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "2.3.4",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@stryker-mutator/core": "9.6.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.13",
    "@tsconfig/svelte": "5.0.9",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "cspell": "10.5.2",
    "dependency-cruiser": "18.9.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "secretlint": "13.1.0",
    "stryker-mutator-bun-runner": "0.4.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0"
  },
  "patchedDependencies": {
    "stryker-mutator-bun-runner@0.4.0": "patches/stryker-mutator-bun-runner@0.4.0.patch"
  }
}
