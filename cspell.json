{
  "version": "0.2",
  "language": "en,ru",
  "dictionaries": ["project-words", "@cspell/dict-ru_ru"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dev-dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.stryker-tmp/**",
    "**/.agents/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "bun.lock",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.svg",
    "**/*.zip",
    "**/*.wasm",
    "**/*.db"
  ]
}
